# TypeSafe Jev judge (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# Optional: override the API root (default https://api.typesafe.ai/v1)
TYPESAFE_BASE_URL=
# Optional: Jev model version (default jev-1.13.0)
MEMWORTHY_MODEL=
# Default judge provider for Gate() and the CLI: jev (default), openai, microsoft or a plugin
MEMWORTHY_JUDGE=
# OpenAI Decisions judge (https://developers.openai.com/api/docs/guides/decisions)
OPENAI_API_KEY=
# Optional: override the API root (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional: Decisions model (default gpt-6-luna)
OPENAI_DECISIONS_MODEL=
# Microsoft-Decision-1 on Microsoft Foundry (judge "microsoft")
# Endpoint from the deployment page, e.g. https://<resource>.services.ai.azure.com
# (the full .../providers/microsoft/v1/systemone URL also works)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Optional: deployment name (sent as the request's model); found automatically when unset
AZURE_FOUNDRY_DEPLOYMENT=
# Extractor: any OpenAI-compatible chat model via OpenRouter
OPENROUTER_API_KEY=
EXTRACTOR_MODEL=
