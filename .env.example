# TypeSafe Jev judge (https://docs.typesafe.ai)
TYPESAFE_API_KEY=
# Optional: override the API root (default https://api.typesafe.ai/v1)
TYPESAFE_BASE_URL=
# Optional: Jev model version (default jev-1.13.0)
MEMWORTHY_MODEL=
# Default judge provider for Gate() and the CLI: jev (default), openai or a plugin name
MEMWORTHY_JUDGE=
# OpenAI Decisions judge (https://developers.openai.com/api/docs/guides/decisions)
OPENAI_API_KEY=
# Optional: override the API root (default https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional: Decisions model (default gpt-6-luna)
OPENAI_DECISIONS_MODEL=
# Extractor: any OpenAI-compatible chat model via OpenRouter
OPENROUTER_API_KEY=
EXTRACTOR_MODEL=
